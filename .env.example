# Required provider credentials. Never commit real values.
PINECONE_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# PINECONE_INDEX=agent-harness-v2
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# EMBEDDING_MODEL=text-embedding-3-small
# MAX_EMBEDDING_TOKENS=8000
# LLM_MODEL=gpt-6-luna
# MAX_CONTEXT_TOKENS=3500
# MAX_STEPS=6
# MAX_CONCURRENT_RUNS=8
# MAX_RUN_TOKENS=50000
# MAX_RUN_USD=0.25
# LLM_INPUT_COST_PER_1M=0.10
# LLM_OUTPUT_COST_PER_1M=0.50
# EMBEDDING_COST_PER_1M=0.02
# PROVIDER_TIMEOUT_S=30
# PROVIDER_MAX_RETRIES=1
# TOOL_TIMEOUT_S=2.0
# TOOL_OUTPUT_MAX_BYTES=4096
# PINECONE_INDEX_READY_TIMEOUT_S=120
# SOFT_DELETE_RETENTION_DAYS=14
# API_HOST=127.0.0.1
# API_PORT=8000
# LOG_LEVEL=INFO
# CORS_ORIGINS=https://your-approved-console.example

# Authentication is fail-closed. Generate unique random keys (at least 32 chars)
# and assign each key a distinct safe user ID. No demo/default keys are provided.
# Format: API_KEYS=<random-key>:<user-id>,<random-key>:<user-id>
API_KEYS=

# Optional Redis-backed session store
# REDIS_URL=redis://localhost:6379/0
# REDIS_CONNECT_TIMEOUT_S=3
# REDIS_SOCKET_TIMEOUT_S=5

# Neural sidecar data paths
SIDECAR_DB=data/vectors.db
SYNAPTIC_DB=data/synapses.db
UTILITY_MODEL_PATH=data/utility_model.json
