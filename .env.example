# Required
PINECONE_API_KEY=your-pinecone-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional overrides (all optional – sensible defaults are built-in)
# PINECONE_INDEX=agent-harness-v2
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# MAX_CONTEXT_TOKENS=3500
# MAX_STEPS=6
# MAX_RUN_TOKENS=50000
# MAX_RUN_USD=0.25
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO
# CORS_ORIGINS=*

# Auth (required for /chat)
API_KEYS=sk-demo-abc123:alice,sk-demo-def456:bob

# Sessions (leave blank for in-memory dev fallback)
# REDIS_URL=redis://localhost:6379/0

# Neural health probes
SIDECAR_DB=data/vectors.db
SYNAPTIC_DB=data/synapses.db
UTILITY_MODEL=data/utility.pt
